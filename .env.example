# Set to "1" to use the SQLite mock adapter (no API key required).
# Unset/0 means real Trendyol API calls (requires keys below).
TRENDYOL_USE_MOCK=1

# Trendyol Marketplace API credentials (https://partner.trendyol.com)
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Optional: override mock SQLite path. Defaults to ~/.commerce-mcp/trendyol.db
TRENDYOL_DB_PATH=

# Optional integrator name for User-Agent header. Defaults to "SelfIntegration".
TRENDYOL_INTEGRATOR_NAME=SelfIntegration

# ChatGPT App HTTP MCP server
COMMERCE_MCP_HOST=127.0.0.1
COMMERCE_MCP_PORT=2091
COMMERCE_MCP_PUBLIC_ORIGIN=http://127.0.0.1:2091
COMMERCE_MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to 1 in hosted environments. Local development can keep this at 0.
COMMERCE_MCP_AUTH_REQUIRED=0
COMMERCE_MCP_DEV_BEARER_TOKEN=
COMMERCE_MCP_AUTH_ISSUER=
COMMERCE_MCP_AUTH_SCOPES=trendyol.read,trendyol.write
COMMERCE_MCP_RESOURCE_DOCS_URL=

# Used to sign preview tokens for execute_* write tools.
COMMERCE_MCP_CONFIRMATION_SECRET=change-me
