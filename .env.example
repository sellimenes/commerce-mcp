# Set to "1" to use the SQLite mock adapter (no API key required).
# Unset/0 means real Trendyol API calls (requires keys below).
TRENDYOL_USE_MOCK=1

# Trendyol Marketplace API credentials (https://partner.trendyol.com)
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

# Optional: override mock SQLite path. Defaults to ~/.commerce-mcp/trendyol.db
TRENDYOL_DB_PATH=

# Optional integrator name for User-Agent header. Defaults to "SelfIntegration".
TRENDYOL_INTEGRATOR_NAME=SelfIntegration
