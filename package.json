{
  "name": "commerce-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP servers for Turkish e-commerce marketplaces (Trendyol, Hepsiburada, ...)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "dev:trendyol": "npm run dev --workspace @commerce-mcp/trendyol",
    "seed:trendyol": "npm run seed --workspace @commerce-mcp/trendyol",
    "db:generate:trendyol": "npm run db:generate --workspace @commerce-mcp/trendyol",
    "inspect:trendyol": "npx -y @modelcontextprotocol/inspector node packages/trendyol/dist/bin/trendyol-mcp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
